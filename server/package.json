{
  "name": "@cardkun/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "collect": "tsx src/scripts/collect.ts"
  },
  "dependencies": {
    "@cardkun/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "postgres": "^3.4.9",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
